---
// This is a "layout" — a reusable page shell. Every inner page (about.astro,
// resume.astro, contact.astro, 404.astro, and the projects pages) wraps its
// own content in <PageLayout> instead of repeating this <html>/<head>/<body>
// boilerplate five times. See any of those files for what that looks like
// from the calling side — it's short, because all of THIS is shared.
import BaseHead from './BaseHead.astro';
import Curtain from '../components/Curtain.astro';

interface Props {
  title?: string;
  description?: string;
  pageTitle: string; // required (no "?") — every page must supply its own <h1> text
}

const { title = 'Aurameow', description = 'Aurameow resume', pageTitle } = Astro.props;
---

<!--
  Inner pages (About/Resume/Contact/404) on the live site are rendered as an
  AJAX-injected `.one-page-content` overlay on top of the home page — full
  white background, a floating black "X" (`.close-page`) fixed at top-center
  that closes back to home, and NO header/nav/footer chrome (that chrome only
  belongs to the home page itself). This layout reproduces that same visual
  structure: `.close-page` is a normal <a href="/"> link, which Astro's
  client router (see astro:transitions in BaseHead.astro) intercepts to swap
  pages without a real browser reload, while transitions.ts plays the
  curtain wipe on top so it still feels like a real transition.
-->
<!DOCTYPE html>
<html
  lang="en"
  class="no-js"
  data-click-ripple-animation="yes"
>
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body>
    {/* The floating "X" button, fixed to the top-center of the screen via
        CSS (see main.css's .close-page rules) — clicking it just navigates
        home like any other link. */}
    <a href="/" class="close-page">
      <span class="close-text"></span>
    </a>

    <div class="one-page-content is-visible">
      <div class="content-wrap">
        <article class="page hentry">
          <header class="entry-header">
            <h1 class="entry-title">{pageTitle}</h1>
          </header>

          <div class="entry-content">
            {/* <slot /> is where the *calling* page's own content gets
                inserted. e.g. about.astro writes
                  <PageLayout pageTitle="About Me"> ...its content... </PageLayout>
                and that "...its content..." is exactly what renders here. */}
            <slot />
          </div>
        </article>
      </div>
    </div>

    <!-- ALERT : used for contact form mail delivery alert -->
    <div class="site-alert animated"></div>

    <!-- Background music element, invisible here (no toggle UI on inner
         pages, matching the original site). transition:persist keeps this
         exact node (and its playback) alive across client-side navigations,
         so music started on the home page just keeps playing. -->
    <audio id="bg-music" loop src="/audio/music2.mp3" transition:persist="bg-music"></audio>

    <Curtain />

    <!-- SCRIPTS -->
    <script src="../scripts/main.ts"></script>
    <script src="../scripts/transitions.ts"></script>
  </body>
</html>

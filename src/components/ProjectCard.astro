---
// One card in the /projects grid — this file doesn't know or care how many
// posts exist; src/pages/projects/index.astro loops over every post and
// renders one <ProjectCard> per post, passing in that post's data as props.
//
// `<Image>` is Astro's built-in component for pictures: it automatically
// resizes/optimizes the file at build time (that's why it needs explicit
// width/height) instead of shipping the original, possibly-huge image.
import { Image } from 'astro:assets';
// `CollectionEntry<'projects'>` is a TypeScript type Astro generates for
// you, describing exactly what one entry from the "projects" content
// collection looks like (see src/content/config.ts for the actual shape).
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
  readTime: number; // computed by the calling page — see index.astro
}

const { entry, readTime } = Astro.props;
// `entry.data` holds everything from that post's frontmatter block.
const { title, excerpt, category, pubDate, cover, coverAlt } = entry.data;

// pubDate is stored as a JS Date; this formats it as e.g. "Aug 28, 2026"
// for display.
const formattedDate = pubDate.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

{/* `entry.slug` is the post's filename without ".md" — e.g. the file
    hello-projects.md has the slug "hello-projects", so this card links to
    /projects/hello-projects. */}
<a class="project-card" href={`/projects/${entry.slug}`}>
  <div class="project-card-media">
    {
      // Ternary: "cover ? doThis : doThatInstead" — if this post's
      // frontmatter included a `cover` image, show it; otherwise fall
      // back to a plain colored panel with the category name, so a post
      // without a photo never looks like a broken image.
      cover ? (
        <Image src={cover} alt={coverAlt ?? ''} width={640} height={420} />
      ) : (
        <div class="project-card-media-fallback">
          <span>{category}</span>
        </div>
      )
    }
  </div>

  <div class="project-card-body">
    <p class="project-card-meta">
      <span class="project-card-category">{category}</span>
      <span aria-hidden="true">·</span>
      <span>{formattedDate}</span>
      <span aria-hidden="true">·</span>
      <span>{readTime} min read</span>
    </p>

    <h2 class="project-card-title">{title}</h2>
    <p class="project-card-excerpt">{excerpt}</p>

    <span class="project-card-link">Read article <span aria-hidden="true">&rarr;</span></span>
  </div>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    color: inherit;
    background: #fff;
    transition: background 0.25s ease-out;
  }
  .project-card:hover {
    background: #fafaff;
  }
  .project-card:hover .project-card-title {
    color: #1851f1;
  }
  .project-card:hover .project-card-media img {
    transform: scale(1.03);
  }

  .project-card-media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #000;
  }
  .project-card-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease-out;
  }
  .project-card-media-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #111;
  }
  .project-card-media-fallback span {
    font-family: 'Anton', sans-serif;
    font-size: calc(16px + 1vw);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    opacity: 0.85;
  }

  .project-card-body {
    padding: 1.6em 1.8em 2em;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .project-card-meta {
    margin: 0 0 0.8em;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #999;
    display: flex;
    gap: 0.5em;
  }
  .project-card-category {
    color: #1851f1;
  }

  .project-card-title {
    margin: 0 0 0.5em;
    font-size: calc(18px + 0.6vw);
    line-height: 1.25;
    font-weight: 500;
    transition: color 0.2s ease-out;
  }

  .project-card-excerpt {
    margin: 0 0 1.2em;
    color: #666;
    font-size: 14px;
    line-height: 1.6;
    flex: 1;
  }

  .project-card-link {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>

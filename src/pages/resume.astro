---
// The Resume page. Same `.map()` pattern as about.astro for turning a
// plain array of data into repeated HTML — see that file's SERVICES
// section for a step-by-step explanation if this looks unfamiliar.
import PageLayout from '../layouts/PageLayout.astro';

const systemsSkills = [
  { name: 'Application Security (JWT, RBAC)', percent: 85 },
  { name: 'PostgreSQL & REST APIs', percent: 85 },
  { name: 'Server & Network Administration', percent: 80 },
  { name: 'Linux / Nix OS', percent: 75 },
];

const codingSkills = [
  { name: 'JavaScript (React, Next.js)', percent: 90 },
  { name: 'PHP', percent: 85 },
  { name: 'TypeScript', percent: 75 },
  { name: 'Python', percent: 70 },
];
---

<PageLayout title="Aurameow" pageTitle="Resume">
  <div class="row">
    <!-- col -->
    <div class="col-sm-6 col-lg-7">
      <div class="event">
        <h2>WORK HISTORY</h2>
        <p><i class="pw-icon-badge"></i></p>
      </div>

      <div class="event">
        <h3>Sep 2022 - Current</h3>
        <h4>Full Stack Developer (Intern)</h4>
        <h5>Tanzania Mercantile Exchange (TMX)</h5>
        <ul>
          <li>
            Re-engineered the original OTS pilot into a modular, service-oriented platform
            covering the full trading lifecycle — warehouse receipt intake, catalogue and
            auction management, live bidding, and clearing and settlement.
          </li>
          <li>
            Built responsive, secure interfaces and back-end services for pre-trade, trade,
            and post-trade workflows using React with a PostgreSQL data layer.
          </li>
          <li>
            Implemented real-time bidding dashboards and trade session updates over
            WebSockets for high-traffic sessions.
          </li>
          <li>
            Developed REST APIs integrating with banks, mobile-money services, and government
            platforms (GePG, the Warehouse Receipt Registry) via the Government Enterprise
            Service Bus (GOVESB).
          </li>
          <li>
            Enforced application security through JWT authentication, role-based access
            control, and immutable audit logging of trades and settlements.
          </li>
          <li>
            Managed deployment, servers, and network security, including hosting at the
            e-Government Authority (e-GA).
          </li>
        </ul>
      </div>

      <div class="event">
        <h2>EDUCATION</h2>
        <p><i class="pw-icon-education"></i></p>
      </div>

      <div class="event">
        <h3>2017 - 2022</h3>
        <h4>Bachelor of Software Engineering</h4>
        <h5>Shanghai Dianji University, Shanghai, China</h5>
      </div>

      <div class="event">
        <h3>2012 - 2016</h3>
        <h4>Middle School Diploma</h4>
        <h5>Biralee International School, Trondheim, Norway</h5>
      </div>

      <p>
        <a href="/files/nanayaw-osafokissi-cv.pdf" download class="button primary">
          <i class="pw-icon-doc-alt"></i>Download CV
        </a>
      </p>
    </div>
    <!-- col -->

    <!-- col -->
    <div class="col-sm-6 col-lg-5">
      <div class="section-title center">
        <h2><i>Systems &amp; Security</i></h2>
      </div>

      {/* The skill bar's fill width is set directly from `s.percent` right
          here (`width:${s.percent}%`), computed once when the page is
          built — not filled in later by JavaScript. That means the bars
          show at the right width immediately, even before any script has
          run, and still work if JS is disabled entirely. */}
      {systemsSkills.map((s) => (
        <div class="skill-unit">
          <h4>{s.name}</h4>
          <div class="bar" data-percent={s.percent}>
            <div class="progress" style={`width:${s.percent}%`}>
              <span>{s.percent}</span>
            </div>
          </div>
        </div>
      ))}

      <div class="section-title center">
        <h2><i>Dev Skills</i></h2>
      </div>

      {codingSkills.map((s) => (
        <div class="skill-unit">
          <h4>{s.name}</h4>
          <div class="bar" data-percent={s.percent}>
            <div class="progress" style={`width:${s.percent}%`}>
              <span>{s.percent}</span>
            </div>
          </div>
        </div>
      ))}

      <div class="section-title center">
        <h2><i>TESTIMONIALS</i></h2>
      </div>

      <div class="testo">
        <img src="/images/site/testo-01.jpg" alt="Goodluck Luhanjo" />
        <h3>Goodluck Luhanjo</h3>
        <h5>System Administrator, TMX</h5>
        <p>
          I had the pleasure of working with Nana as a mentor during his internship at TMX.
          He is a quick learner and eager to take on new challenges.
          He's also a team player and always willing to help out his colleagues.
          I am confident that he has the skills and attitude to be a successful
          software developer.
        </p>
      </div>
    </div>
    <!-- col -->
  </div>
</PageLayout>

<style>
  /* .event p (main.css) styles the timeline's description text, but this
     job entry uses a bullet list instead of a paragraph — these rules
     just carry that same spacing/sizing over to the <ul>/<li> here. */
  .event ul {
    margin: 0.6em 0 0.2em 0;
    padding-left: 1.1em;
    font-size: 0.95em;
    letter-spacing: 0.3px;
  }
  .event li {
    margin: 0.5em 0;
  }
</style>

---
// The About page. Like every page that isn't home, this wraps its content
// in PageLayout (see src/layouts/PageLayout.astro) and only needs to
// supply the page title + whatever goes inside — no repeated <html>/
// header/close-button markup.
//
// The four arrays below are just plain data — editing "TITLE:" text or
// adding/removing an item here is enough; you don't need to touch any
// HTML to change what shows up. Below, each array gets turned into HTML
// with `.map(...)`, a pattern you'll see repeated a few times on this
// page: for every item in the list, return one chunk of HTML for it. See
// the SERVICES section below for the first, most-commented example.
import PageLayout from '../layouts/PageLayout.astro';

const services = [
  { icon: 'service-01.svg', title: 'Full-Stack Development', text: 'Building responsive, secure web applications end to end with React, REST APIs, and PostgreSQL-backed data layers.' },
  { icon: 'service-02.svg', title: 'Real-Time Systems', text: 'Designing WebSocket-based live features — bidding dashboards, trade session updates — built to hold up under high traffic.' },
  { icon: 'service-03.svg', title: 'Application Security', text: 'Enforcing JWT authentication, role-based access control, and immutable audit logging to keep transactions and data safe.' },
  { icon: 'service-04.svg', title: 'Systems & Integrations', text: 'Connecting applications to external financial and government platforms, and managing the servers and networks behind them.' },
];

const process = [
  { icon: 'process-01.svg', title: 'Research' },
  { icon: 'process-02.svg', title: 'IDEA' },
  { icon: 'process-03.svg', title: 'DESIGN' },
  { icon: 'process-04.svg', title: 'DEVELOP' },
  { icon: 'process-05.svg', title: 'TEST' },
  { icon: 'process-06.svg', title: 'LAUNCH' },
];

// Same 7 files as the live site, with client-01 repeated for the 8th slot
// (that's how it's ordered in production).
const clientLogos = [
  'client-01.png', 'client-02.png', 'client-03.png', 'client-04.png',
  'client-05.png', 'client-06.png', 'client-07.png', 'client-01.png',
];

const funFacts = [
  { icon: 'fun-01.svg', title: '18 Projects Completed' },
  { icon: 'fun-02.svg', title: '35 Git repositories' },
];
---

<PageLayout title="Aurameow" pageTitle="About Me">
  <div class="boxed is-dark">
    <div class="row">
      <div class="col-sm-3">
        <img src="/images/site/aru.jpeg" alt="about image" />
      </div>

      <div class="col-sm-9">
        <h2 class="fw-300">
          Hello, I am Nanayaw, a <strong>software developer</strong> based in Dar es Salaam, Tanzania,
          with over three years of experience building responsive, secure, full-stack web applications.
          I work across the <strong>front end and back end</strong>, on real-time systems, and on
          integrations with financial and government platforms — with a focus on performance,
          reliability, and data integrity.
        </h2>
      </div>
    </div>
  </div>

  <!-- SERVICES -->
  <div class="section-title center">
    <h2><i>services</i></h2>
  </div>

  <div class="row">
    {/* services.map(...) runs the function once per item in the `services`
        array above, and the HTML each call returns is what ends up on the
        page — so this one block of markup produces all 4 service cards,
        one per entry in that array. `s` is just the current item each
        time (its icon/title/text). To add a 5th card, add a 5th object to
        the `services` array — you don't need to copy this HTML at all. */}
    {services.map((s) => (
      <div class="col-sm-6 col-lg-3">
        <div class="service">
          <img src={`/images/site/${s.icon}`} alt="image" />
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </div>
      </div>
    ))}
  </div>
  <!-- SERVICES -->

  <!-- PROCESS -->
  <div class="section-title center">
    <h2><i>work procces</i></h2>
  </div>

  <div class="row">
    {process.map((p) => (
      <div class="col-xs-4 col-sm-2">
        <div class="process">
          <img src={`/images/site/${p.icon}`} alt="image" />
          <h4>{p.title}</h4>
        </div>
      </div>
    ))}
  </div>
  <!-- PROCESS -->

  <!-- CLIENTS -->
  <div class="section-title center">
    <h2><i>Proud to work with</i></h2>
  </div>

  {/* An infinite scrolling marquee instead of a static grid. The trick:
      render the logo list TWICE back to back, then animate the whole
      track exactly 50% to the left, in a continuous loop. Since the
      second half is an identical copy of the first, the instant it loops
      back to 0% it looks exactly like the moment before — the seam is
      invisible. `clientLogos` itself still only lists the real 8 logos;
      the duplication only happens here, at render time.

      The second copy is marked aria-hidden (screen readers shouldn't
      announce the same 8 logos twice) and gets a "duplicate" class so the
      reduced-motion fallback below can hide it and show a plain, single
      row instead. */}
  <div class="marquee">
    <div class="marquee-track">
      {clientLogos.map((logo) => (
        <div class="client marquee-item">
          <a href="#">
            <img src={`/images/site/${logo}`} alt="client" />
          </a>
        </div>
      ))}
      {clientLogos.map((logo) => (
        <div class="client marquee-item marquee-duplicate" aria-hidden="true">
          <a href="#" tabindex="-1">
            <img src={`/images/site/${logo}`} alt="" />
          </a>
        </div>
      ))}
    </div>
  </div>
  <!-- CLIENTS -->

  <!-- FUN FACT 
  <div class="section-title center">
    <h2><i>fun fact</i></h2>
  </div>

  <div class="row">
    {funFacts.map((f) => (
      <div class="col-xs-6 col-sm-3">
        <div class="fun-fact">
          <img src={`/images/site/${f.icon}`} alt="fun fact" />
          <h4>{f.title}</h4>
        </div>
      </div>
    ))}
  </div>
   FUN FACT -->
</PageLayout>

<style>
  .marquee {
    /* Hides the duplicated second half sitting off to the right, and
       fades the edges so logos don't look like they're cut off mid-box. */
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content; /* let the track be exactly as wide as its (doubled) content */
    animation: marquee-scroll 24s linear infinite;
  }

  /* Pausing on hover makes each logo's link actually clickable/readable
     instead of only ever whizzing past. */
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-item {
    flex: 0 0 220px; /* fixed width per logo box, instead of the grid's percentage columns */
    margin: 0 4px;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      /* Exactly half the track's width, since the track is two identical
         copies of the logo list back to back — this is what makes the
         loop seamless instead of snapping back to the start. */
      transform: translateX(-50%);
    }
  }

  /* Respect users who've asked their OS to reduce motion: show the logos
     as a plain static row instead of forcing the animation on them. */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
      width: 100%;
    }
    .marquee-duplicate {
      display: none;
    }
  }
</style>

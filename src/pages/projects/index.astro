---
// The /projects listing page — a grid of every post in src/content/projects/.
// getCollection is Astro's built-in way to read a whole content collection;
// this is the piece that turns "a folder of markdown files" into "a page
// showing all of them", so this file is worth reading alongside
// src/content/config.ts (defines what a post looks like) and
// src/components/ProjectCard.astro (renders one).
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const WORDS_PER_MINUTE = 200; // rough average — used below to estimate read time

// getCollection('projects', ...) reads every .md file in
// src/content/projects/. The second argument is a filter function: return
// true to keep an entry, false to skip it — here, that means "skip
// anything marked draft: true in its frontmatter".
const allEntries = await getCollection('projects', ({ data }) => !data.draft);

// .sort() reorders the array in place. `b.data.pubDate.valueOf() -
// a.data.pubDate.valueOf()` is a common trick for "sort dates newest
// first" — .valueOf() turns a Date into a plain number (milliseconds),
// and putting `b` before `a` reverses the usual smallest-first order.
const entries = allEntries.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Builds a lookup table of "post slug → estimated minutes to read", by
// counting words in the post's raw markdown body and dividing by a typical
// reading speed. A Map is just a key/value store, similar to a plain
// object but built for exactly this kind of lookup-by-key use.
const readTimes = new Map(
  entries.map((entry) => [
    entry.slug,
    Math.max(1, Math.round(entry.body.trim().split(/\s+/).length / WORDS_PER_MINUTE)),
  ]),
);
---

<PageLayout title="Projects — Aurameow" description="Project write-ups and notes." pageTitle="Projects">
  <p class="projects-intro">
    Write-ups from things I've built, and shorter notes along the way —
    newest first.
  </p>

  {
    // Ternary again (see ProjectCard.astro for the same pattern): if there
    // are no published posts, show a friendly message instead of an empty
    // grid. Otherwise, render one <ProjectCard> per entry.
    entries.length === 0 ? (
      <p>Nothing published yet — check back soon.</p>
    ) : (
      <div class="projects-grid">
        {entries.map((entry) => (
          // The "!" after .get(...) tells TypeScript "trust me, this will
          // never be undefined" — safe here because readTimes was built
          // from this exact same `entries` array above, so every slug is
          // guaranteed to already be in the map.
          <ProjectCard entry={entry} readTime={readTimes.get(entry.slug)!} />
        ))}
      </div>
    )
  }
</PageLayout>

<style>
  .projects-intro {
    max-width: 46em;
    margin: 0 0 2.4em;
    font-size: calc(15px + 0.2vw);
    color: #555;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 4px;
  }
  .projects-grid > :global(.project-card) {
    border: 1px solid #111;
  }

  @media (max-width: 767px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
// This file's name — [slug].astro, with square brackets — is Astro's
// syntax for a "dynamic route": one file that generates MANY pages, one
// per project post, instead of writing about.astro-style files by hand
// for each one. `slug` becomes a URL parameter you can read below.
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';

const WORDS_PER_MINUTE = 200;

// Astro calls this function once, at build time, to ask "which pages
// should exist, and what data does each one need?" Returning one object
// per post — `params.slug` becomes that post's URL (e.g. slug:
// "hello-projects" → the page /projects/hello-projects), and whatever's in
// `props` gets handed to this same file as `Astro.props` below, for that
// specific page.
export async function getStaticPaths() {
  const entries = await getCollection('projects', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// This runs separately for EACH page getStaticPaths described above — so
// on the /projects/hello-projects page, `entry` is that one post; on
// /projects/tmx-socials-generator, it's that one instead.
const { entry } = Astro.props;
const { title, excerpt, category, pubDate, cover, coverAlt, repoUrl } = entry.data;
// entry.render() turns the post's markdown body into an actual Astro
// component you can drop into the page — `<Content />` below is literally
// the rendered HTML of everything written after the frontmatter in that
// post's .md file.
const { Content } = await entry.render();

const readTime = Math.max(1, Math.round(entry.body.trim().split(/\s+/).length / WORDS_PER_MINUTE));
const formattedDate = pubDate.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<PageLayout title={`${title} — Aurameow`} description={excerpt} pageTitle={title}>
  <p class="project-meta">
    <span class="project-category">{category}</span>
    <span aria-hidden="true">·</span>
    <span>{formattedDate}</span>
    <span aria-hidden="true">·</span>
    <span>{readTime} min read</span>
  </p>

  <p class="project-excerpt">{excerpt}</p>

  {
    // `repoUrl && (...)` is a shortcut for "only render this if repoUrl has
    // a value". JavaScript's && stops and returns the left side as soon as
    // it's falsy (like undefined) — so when a post has no repoUrl, this
    // whole block evaluates to `undefined` and Astro simply renders
    // nothing, no explicit if/else needed.
    repoUrl && (
      <p class="project-repo-link">
        <a href={repoUrl} target="_blank" rel="noopener noreferrer">
          View source on GitHub <span aria-hidden="true">&rarr;</span>
        </a>
      </p>
    )
  }

  {
    cover && (
      <div class="project-cover">
        <Image src={cover} alt={coverAlt ?? ''} width={1180} height={620} />
      </div>
    )
  }

  <div class="project-body">
    <Content />
  </div>

  <p class="project-back"><a href="/projects">&larr; Back to all projects</a></p>
</PageLayout>

<style>
  .project-meta {
    margin: 0 0 1em;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #999;
    display: flex;
    gap: 0.5em;
    justify-content: center;
  }
  .project-category {
    color: #1851f1;
  }

  .project-excerpt {
    max-width: 42em;
    margin: 0 auto 2em;
    text-align: center;
    font-size: calc(15px + 0.2vw);
    color: #555;
  }

  .project-repo-link {
    text-align: center;
    margin: 0 0 2em;
  }
  .project-repo-link a {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .project-repo-link a:hover {
    color: #1851f1;
  }

  .project-cover {
    margin: 0 0 2em;
    background: #000;
  }
  .project-cover img {
    display: block;
    width: 100%;
    height: auto;
  }

  .project-body {
    max-width: 42em;
    margin: 0 auto;
  }
  .project-body :global(a) {
    color: #1851f1;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .project-body :global(a:hover) {
    color: #111;
  }
  .project-body :global(ul),
  .project-body :global(ol) {
    margin: 0 0 1.4em;
    padding-left: 1.4em;
  }
  .project-body :global(li) {
    margin: 0.3em 0;
  }
  .project-body :global(pre) {
    padding: 1.2em;
    background: #111;
    color: #eee;
    overflow-x: auto;
    font-size: 13px;
    border-radius: 2px;
  }
  .project-body :global(code) {
    font-family: Monaco, Menlo, Consolas, 'Courier New', monospace;
    font-size: 0.9em;
  }
  .project-body :global(p code) {
    background: #f1f1f1;
    padding: 0.15em 0.4em;
  }

  .project-back {
    text-align: center;
    margin-top: 3em;
  }
  .project-back a {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .project-back a:hover {
    color: #1851f1;
  }
</style>

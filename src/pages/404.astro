---
// Astro automatically serves this exact file (404.astro) whenever someone
// visits a URL that doesn't match any other page — no routing config
// needed, the filename "404" is a reserved convention Astro looks for.
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Aurameow" pageTitle="Oh Nooo!">
  <div class="http-alert">
    <h1><i class="pw-icon-way"></i></h1>
    <p>The page you are looking for was not found!</p>
  </div>
</PageLayout>
